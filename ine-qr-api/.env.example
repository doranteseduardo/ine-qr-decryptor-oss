# Copia este archivo a .env y ajusta los valores
# cp .env.example .env

# Clave de acceso a la API (requerida en producción)
API_KEY=cambia_esto_por_una_clave_segura

# Puerto HTTP (default: 8080)
PORT=8080

# Ruta al binario ine_decode (default: ./ine_decode)
# DECODER_PATH=../ine-qr-c/ine_decode

# Máximo de decodificaciones simultáneas (default: número de CPU cores)
# WORKERS=4
